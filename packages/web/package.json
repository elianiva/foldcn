{
  "name": "@foldcn/web",
  "version": "0.1.0",
  "private": true,
  "description": "The foldcn showcase: a Foldkit app (SSG) presenting every registry item with live previews, install commands and source views.",
  "type": "module",
  "scripts": {
    "predev": "node ../registry/scripts/resolve-styles.mjs",
    "dev": "portless run --name foldcn vite",
    "prebuild": "node ../registry/scripts/resolve-styles.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.109",
    "@foldcn/registry": "workspace:*",
    "@foldkit/devtools": "^0.148.0",
    "@foldkit/ui": "^0.148.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/highlight": "^0.0.10",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.109",
    "foldkit": "^0.148.0",
    "lucide": "^1.32.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "^0.16.0",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.2",
    "node-html-markdown": "^2.0.0",
    "portless": "^0.15.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
