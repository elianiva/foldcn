{
  "name": "@foldcn/web",
  "version": "0.1.0",
  "private": true,
  "description": "The foldcn showcase: a Foldkit app (SSG) presenting every registry item with live previews, install commands and source views.",
  "type": "module",
  "scripts": {
    "predev": "node ../registry/scripts/resolve-styles.mjs && node scripts/generate-style-shims.mjs",
    "dev": "vite",
    "predev:local": "node ../registry/scripts/resolve-styles.mjs && node scripts/generate-style-shims.mjs",
    "dev:local": "portless run --name foldcn vite",
    "prebuild": "node ../registry/scripts/resolve-styles.mjs && node scripts/generate-style-shims.mjs",
    "pretypecheck": "node ../registry/scripts/resolve-styles.mjs && node scripts/generate-style-shims.mjs",
    "pretest": "node ../registry/scripts/resolve-styles.mjs && node scripts/generate-style-shims.mjs",
    "build": "tsx scripts/build.ts",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@foldcn/registry": "workspace:*",
    "@foldkit/devtools": "^0.169.0",
    "@foldkit/ui": "^0.169.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/highlight": "^1.2.0",
    "cn": "^0.5.0",
    "defuddle": "^0.19.6",
    "effect": "4.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "foldkit": "^0.169.0",
    "linkedom": "^0.18.14",
    "lucide": "^1.61.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "^0.28.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "portless": "^0.15.12",
    "takumi-js": "^2.18.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
