{
  "name": "foldcn",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn-style registry of styled components for Foldkit, built on @foldkit/ui.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check",
    "dev": "turbo run dev",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "turbo run validate",
    "infra:deploy": "alchemy deploy --stage prod --yes",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@oxlint/plugins": "1.89.0",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plus": "^1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
